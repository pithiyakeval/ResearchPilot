# Optional: copy this file to .env to override the defaults below.
# ResearchPilot uses a local Ollama server; no API key is required.
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0
# Context window and per-response cap, in tokens. NUM_PREDICT must be at most NUM_CTX / 4.
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2048
# Maximum analysis passes (1-3).
RESEARCHPILOT_MAX_ANALYSIS_PASSES=2

# --- HTTP API (optional; only for `uv run python -m researchpilot.api`) ---
# Defaults shown. Binding to anything other than 127.0.0.1 exposes an API that has no
# authentication.
# RESEARCHPILOT_API_HOST=127.0.0.1
# RESEARCHPILOT_API_PORT=8000
# RESEARCHPILOT_API_READY_TIMEOUT_SECONDS=2.0
# RESEARCHPILOT_API_MAX_REQUEST_BYTES=1048576
# RESEARCHPILOT_API_MAX_QUEUED_JOBS=4
# RESEARCHPILOT_API_MAX_RETAINED_JOBS=50
# RESEARCHPILOT_API_SHUTDOWN_TIMEOUT_SECONDS=5.0

# --- Job history database (required by the HTTP API, not by the CLI) ---
# A PostgreSQL URL using the postgresql+psycopg:// scheme. Put the real value only in your
# own .env, never in this file. Placeholder form:
# RESEARCHPILOT_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
# Optional tuning (defaults shown):
# RESEARCHPILOT_DATABASE_CONNECT_TIMEOUT_SECONDS=3
# RESEARCHPILOT_DATABASE_STATEMENT_TIMEOUT_MS=5000
# RESEARCHPILOT_DATABASE_LOCK_TIMEOUT_MS=2000
# RESEARCHPILOT_DATABASE_POOL_SIZE=5
# RESEARCHPILOT_DATABASE_MAX_OVERFLOW=5
# RESEARCHPILOT_DATABASE_POOL_TIMEOUT_SECONDS=5.0
